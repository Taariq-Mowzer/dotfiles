# Requires vivid. brew install vivid
cache="${XDG_CACHE_HOME:-$HOME/.cache}/ls_colors.tokyonight-night"
if [[ ! -f $cache || $cache -ot ~/.zshrc ]]; then
  mkdir -p "${cache:h}"
  vivid generate tokyonight-night >| "$cache"
fi
LS_COLORS="$(<"$cache")"
export LS_COLORS
# make ls use colors
export CLICOLOR=1 
# Use lsd instead to properlty render colors
alias ls="lsd --icon never --group-dirs first"
alias lg="lazygit"

alias toucht="touch -t 199901011200"

tss() {
  local name="$1"
  [ -z "$name" ] && return 1

  if [ -n "$TMUX" ]; then
    tmux has-session -t "$name" 2>/dev/null \
      && tmux switch-client -t "$name" \
      || tmux new-session -ds "$name" \; switch-client -t "$name"
  else
    tmux new-session -As "$name"
  fi
}

export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export UV_MANAGED_PYTHON=true

set -o vi
# Ctrl-P for previous command
bindkey '^P' history-beginning-search-backward
# Ctrl-N for next command 
bindkey '^N' down-line-or-history
# Yazi change directory on exit
function yy() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		cd -- "$cwd"
                zle reset-prompt
	fi
	rm -f -- "$tmp"
}
#Lazy-load pyenv
pyenv() {
  unset -f pyenv
  eval "$(command pyenv init -)"
  eval "$(command pyenv virtualenv-init -)"
  pyenv "$@"
}

