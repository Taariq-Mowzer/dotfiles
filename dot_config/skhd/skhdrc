# Change window focus

# change window focus within space
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - h : yabai -m window --focus west
cmd - l : yabai -m window --focus east
cmd - o : yabai -m window --focus recent

#change focus between external displays (left and right)
cmd - a: yabai -m display --focus west
cmd - d: yabai -m display --focus east

# rotate layout clockwise
cmd - r : yabai -m space --rotate 270

# flip along y-axis
cmd - y : yabai -m space --mirror y-axis

# flip along x-axis
cmd - x : yabai -m space --mirror x-axis

# toggle window float
cmd + shift - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Modify window size

# maximise window
cmd - m: yabai -m window --toggle zoom-fullscreen

# balance window sizes
cmd - b: yabai -m space --balance

# swap windows
cmd + alt - j : yabai -m window --swap south
cmd + alt - k : yabai -m window --swap north
cmd + alt - h : yabai -m window --swap west
cmd + alt - l : yabai -m window --swap east

# move window and split
cmd + ctrl - j : yabai -m window --warp south
cmd + ctrl - k : yabai -m window --warp north
cmd + ctrl - h : yabai -m window --warp west
cmd + ctrl - l : yabai -m window --warp east

# move window to display left and right
cmd + ctrl - a : yabai -m window --display west; yabai -m display --focus west
cmd + ctrl - d : yabai -m window --display east; yabai -m display --focus east

# move window to space #
cmd + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
cmd + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
cmd + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
cmd + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4 
cmd + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
cmd + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
cmd + alt - 7 : yabai -m window --space 7; yabai -m space --focus 7
cmd + alt - 8 : yabai -m window --space 8; yabai -m space --focus 8
cmd + alt - 9 : yabai -m window --space 9; yabai -m space --focus 9

# move window to space # without focusing the space
cmd + ctrl + alt - 1 : yabai -m window --space 1
cmd + ctrl + alt - 2 : yabai -m window --space 2
cmd + ctrl + alt - 3 : yabai -m window --space 3
cmd + ctrl + alt - 4 : yabai -m window --space 4
cmd + ctrl + alt - 5 : yabai -m window --space 5
cmd + ctrl + alt - 6 : yabai -m window --space 6
cmd + ctrl + alt - 7 : yabai -m window --space 7
cmd + ctrl + alt - 8 : yabai -m window --space 8
cmd + ctrl + alt - 9 : yabai -m window --space 9

# focus workspace
alt - 1 : yabai -m space --focus 1;
alt - 2 : yabai -m space --focus 2;
alt - 3 : yabai -m space --focus 3;
alt - 4 : yabai -m space --focus 4;
alt - 5 : yabai -m space --focus 5;
alt - 6 : yabai -m space --focus 6;
alt - 7 : yabai -m space --focus 7;
alt - 8 : yabai -m space --focus 8;
alt - 9 : yabai -m space --focus 9;
alt - o : yabai -m space --focus recent;
